# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/tsegzuraas

# Admin эрх автоматаар олгох имэйлүүд (таслалаар тусгаарлана, эх кодод бичихгүй)
